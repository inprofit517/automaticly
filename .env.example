# Microsoft Graph (Entra app registration) — booking API
# Copy this file to ".env" and fill in the values. ".env" is git-ignored.

# From the app's Overview page (not secret):
MS_TENANT_ID=05da1499-106a-4fd6-9bea-63992c9336e6
MS_CLIENT_ID=d858bce5-c799-4cc1-97f7-906168eddfa5

# From "Certificates & secrets" → the secret VALUE (SECRET — never commit).
# Leave as CHANGE_ME to run the API in mock mode.
MS_CLIENT_SECRET=CHANGE_ME

# Booking configuration
CALENDAR_EMAIL=info@automaticly.ch
TIMEZONE=Europe/Zurich
SLOT_MINUTES=20
STEP_MINUTES=30
WORK_START=09:00
WORK_END=17:00
WORK_DAYS=1,2,3,4,5
BUFFER_MINUTES=0
MIN_NOTICE_HOURS=24
WINDOW_DAYS=30
ENABLE_TEAMS=true
PORT=8787
